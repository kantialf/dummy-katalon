SELECT
    sub.MSISDN,
    sub.PRODUCT_ID,
    sub.EFFECTIVE_DATE,
    sub.EXPIRED_DATE,
    prod.PRODUCT_NAME,
    spec.PRICE
FROM SUBSCRIPTION sub
JOIN PRODUCT prod
    ON sub.PRODUCT_ID = prod.PRODUCT_ID
JOIN SPECIFICATION spec
    ON sub.PRODUCT_ID = spec.PRODUCT_ID
WHERE sub.MSISDN = '5262632722';
