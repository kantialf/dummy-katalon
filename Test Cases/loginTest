package Cura;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.testng.Assert;
import org.testng.annotations.*;

import java.time.Duration;

public class loginTest {
    WebDriver driver;
    WebDriverWait wait;

    @BeforeMethod
    public void setup(){
        System.setProperty("webdriver.chrome.driver","C:\\Browser drivers\\chromedriver.exe");
        driver = new ChromeDriver();

        wait = new WebDriverWait(driver, Duration.ofSeconds(4));

        // go to page
        driver.get("https://www.jaknot.pw/");
        driver.manage().window().maximize();
        driver.findElement(By.tagName("body")).click();
    }

    private void clickLogin(){
        WebElement btnLogin = driver.findElement(By.xpath("//*[@id=\"__next\"]/div[4]/div[2]/header/div/div[3]/div[2]/button"));
        btnLogin.click();
    }

    private void login(String email, String password){
        clickLogin();
        WebElement emailInput = driver.findElement(By.xpath("//*[@id=\"headlessui-dialog-:R2b6:\"]/div[2]/div/div/div/form/div[1]/div/div[1]/input"));
        WebElement passwordInput = driver.findElement(By.xpath("//*[@id=\"headlessui-dialog-:R2b6:\"]/div[2]/div/div/div/form/div[2]/div/div/input"));
        WebElement btnMasuk = driver.findElement(By.xpath("//*[@id=\"headlessui-dialog-:R2b6:\"]/div[2]/div/div/div/form/div[3]/button"));

        emailInput.clear();
        emailInput.sendKeys(email);
        passwordInput.clear();
        passwordInput.sendKeys(password);

        btnMasuk.click();

    }

    @Test
    public void validLogin(){
        login("mitrabarutest@gmail.com", "2024Jakmall");

        WebElement profileIcon = wait.until(
                ExpectedConditions.visibilityOfElementLocated(By.cssSelector("#__next > div.Header__StyledHeaderWrapper-sc-y4d4ki-1.ljSNgl > div:nth-child(2) > header > div > div.Header___StyledDiv19-sc-y4d4ki-32.hTFpmc > div:nth-child(1) > div:nth-child(2) > button > span.Button__Adornment-sc-1l0qx1m-0.gTsZHm > svg"))
        );
        Assert.assertTrue(profileIcon.isDisplayed());
    }

    @Test
    public void invalidPasswordLogin(){
        login("mitrabarutest@gmail.com", "2024Jakmall2");
        WebElement errorAlert = wait.until(ExpectedConditions.visibilityOfElementLocated(By.xpath("//*[@id=\"__next\"]/div[1]/div/span[2]")));

        Assert.assertTrue(errorAlert.isDisplayed());
    }

    @AfterMethod
    private void closeBrowaser(){
        driver.quit();
    }
}
